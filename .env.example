# ============================================================
# 恋爱心路历程 · 授权后端 配置文件（示例）
# 用法：把本文件复制为 .env（同名，去掉 .example），填入真实值。
#       服务器启动时会自动读取。.env 不会被提交到代码仓库，请妥善保管。
# ============================================================

# ---------- 基础（可选） ----------
# 服务端口，默认 3000
PORT=3000

# 管理后台密钥。不填则首次启动随机生成并写入 admin.key（每次重装会变）。
# 想固定密钥、或多人协作后台，就在这里写死一个你自己的强密码。
ADMIN_KEY=请改成你自己的强密码

# ---------- 微信支付（可选，不填则自动降级为“后台手动确认发卡”） ----------
# 这些需要你有【微信支付商户号】资质后才能填。
WX_APPID=你的微信小程序或公众号AppID
WX_MCHID=你的微信商户号
WX_APIV3_KEY=你的APIv3密钥（32位字符串）
WX_SERIAL=商户API证书序列号
WX_PRIVKEY=-----BEGIN PRIVATE KEY-----
你的商户API私钥（多行，整段粘贴进来）
-----END PRIVATE KEY-----
WX_NOTIFY_URL=https://你的域名/api/payment/wechat/callback

# ---------- 前端连接地址（部署后必改） ----------
# 注意：前端地址不是这里改，而是改 恋爱心路历程.html 顶部的 BACKEND_URL 常量，
#       把它改成你部署后的域名，例如 https://love.example.com
